{
    "name": "elf-name-generator",
    "version": "4.1.1",
    "description": "Faerûn Name Generator - Elven & Dwarven Names",
    "type": "module",
    "scripts": {
        "build:site": "node scripts/release-site.js build",
        "check:release": "node scripts/release-site.js check",
        "test:release": "node --test scripts/release-site.checks.js",
        "test": "vitest",
        "test:run": "vitest run",
        "test:run:log": "node scripts/run-tests-with-log.js",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest --coverage",
        "test:watch": "vitest --watch",
        "test:log-update": "node scripts/log-test-update.js",
        "lint": "eslint js/ tests/ --cache --cache-location .eslintcache --max-warnings 0",
        "lint:fix": "eslint js/ tests/ --fix --cache --cache-location .eslintcache",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check:duplication": "jscpd js --threshold 0",
        "version:major": "node scripts/version.js major",
        "version:minor": "node scripts/version.js minor",
        "version:patch": "node scripts/version.js patch",
        "version": "npm run version:patch"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@vitest/coverage-v8": "^5.0.5",
        "@vitest/ui": "^5.0.5",
        "eslint": "^10.13.0",
        "globals": "^17.13.0",
        "jscpd": "^5.4.2",
        "jsdom": "^30.1.3",
        "prettier": "^3.9.10",
        "vitest": "^5.0.5",
        "yaml": "^2.9.1"
    }
}
